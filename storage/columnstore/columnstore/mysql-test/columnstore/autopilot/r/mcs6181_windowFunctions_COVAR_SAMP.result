select o_custkey, TRUNCATE(COVAR_SAMP(o_custkey,o_orderkey) OVER (PARTITION BY abs(o_custkey)+2 ORDER BY o_custkey ,o_orderkey ,o_orderdate ), 12) from (select * from orders where o_custkey <= 20000) s order by 1, 2;
