#!/bin/sh
# autopkgtest check: Build and run the upstream test suite.
# (C) 2012 Canonical Ltd.
# Author: Daniel Kessel <d.kessel@gmx.de>

# running the mysql testsuite as described in:
# https://bugs.launchpad.net/ubuntu/+source/mysql-5.5/+bug/959683

echo "Running test 'testsuite'"

MTR_SKIP_TEST_LIST=$(mktemp)
ARCH=$(dpkg --print-architecture)

WORKDIR=$(mktemp -d)
trap 'rm -rf $WORKDIR $MTR_SKIP_TEST_LIST' 0 INT QUIT ABRT PIPE TERM
cd "$WORKDIR" || exit

mkdir var
mkdir tmp

echo "using vardir: $WORKDIR/var"
echo "using tmpdir: $WORKDIR/tmp"

echo "=== Linux/Proc Diagnostics ==="
echo "Checking for Linux-specific test requirements..."
uname -a
echo "--- /proc mount check ---"
mount | grep proc || echo "No proc mount found in mount output"
echo "--- /proc filesystem contents ---"
ls -la /proc/ | head -20
echo "--- /proc/thread_self check ---"
ls -la /proc/thread_self 2>&1 || echo "/proc/thread_self not available"
echo "--- /proc/self check ---"
ls -la /proc/self/ | head -10
echo "--- Checking for container environment ---"
if [ -f /proc/1/cgroup ]; then
  echo "Container cgroups:"
  cat /proc/1/cgroup
fi
if [ -f /proc/self/status ]; then
  echo "CapBnd (Bounding capabilities):"
  grep CapBnd /proc/self/status || echo "No CapBnd found"
fi
echo "--- Kernel version ---"
cat /proc/version
echo "=== End Diagnostics ==="

echo "Generating required locales for tests..."
# Generate locales needed by specific tests
sed -i 's/^# de_DE.iso88591/de_DE.iso88591/' /etc/locale.gen
sed -i 's/^# zh_CN.gbk/zh_CN.gbk/' /etc/locale.gen
locale-gen de_DE.iso88591 zh_CN.gbk

echo "Setting up skip-tests-list"

# Use the arch specific skiplists if exist, otherwise list is empty
if [ -f "/usr/share/mariadb/mariadb-test/unstable-tests.$ARCH" ]
then
  cat "/usr/share/mariadb/mariadb-test/unstable-tests.$ARCH" >> "$MTR_SKIP_TEST_LIST"
fi

# Skip tests that cannot run properly on ci.debian.net / autopkgtests.ubuntu.com
cat >> "$MTR_SKIP_TEST_LIST" << EOF
binlog.binlog_server_start_options : Requires writable /usr
main.ctype_uca : Requires writable /usr
rpl.rpl_gtid_mode : Requires starting server as root ref http://bugs.mysql.com/bug.php?id=70517
EOF

# Skip tests that cannot run properly on Gitlab-CI
if [ -n "$GITLAB_CI" ]
then
  cat >> "$MTR_SKIP_TEST_LIST" << EOF
main.mysqld--help : For unknown reason table-cache is 4000 instead of default 421
EOF
fi

# Store skipped test list in artifacts so it can be viewed while debugging
# failed autopkgtest runs
cp -v "$MTR_SKIP_TEST_LIST" "$AUTOPKGTEST_ARTIFACTS"

cd /usr/share/mariadb/mariadb-test || exit
echo "starting mariadb-test-run.pl..."

# Enable feedback plugin tests
export MTR_FEEDBACK_PLUGIN=1

# Ensure debug sync is enabled (timeout in seconds)
export MTR_DEBUG_SYNC_TIMEOUT=300

# Ensure libjvm.so can be found by the Connect engine JDBC plugin
export LD_LIBRARY_PATH=/usr/lib/jvm/default-java/lib/server:$LD_LIBRARY_PATH

# Ensure test plugins can be found (UDF example, etc.)
export MTR_TEST_PLUGIN_DIR=/usr/lib/mysql/plugin

# Ensure plugins are loaded for testing
export MTR_PLUGIN_LOAD="cracklib_password_check,feedback,server_audit,auth_parsec"

export MTR_PRINT_CORE=detailed

# The $MTR_ARGUMENTS_APPEND is intentionally used to pass in extra arguments
# shellcheck disable=SC2086
eatmydata perl -I. ./mariadb-test-run.pl \
    --force --testcase-timeout=180 --suite-timeout=720 --retry=3 \
    --max-test-fail=0 --max-save-core=1 --max-save-datadir=1 \
    --parallel=auto --big-test --enable-disabled \
    --vardir="$WORKDIR/var" --tmpdir="$WORKDIR/tmp" \
    --xml-report="$AUTOPKGTEST_ARTIFACTS/mariadb-test-run-junit.xml" \
    $MTR_ARGUMENTS_APPEND \
    "$@" 2>&1
TEST_RESULT=$?

if [ $TEST_RESULT -eq 0 ]
then
  echo "run: OK"
else
  echo "run: FAILED (exit code $TEST_RESULT)"
fi

echo "=== AppArmor diagnostics ==="
aa-status 2>/dev/null | grep -A5 -B5 mariadb || true
dmesg | grep -i apparmor | grep -i mariadb || true
journalctl -k | grep -i apparmor | grep -i mariadb || true

exit $TEST_RESULT
