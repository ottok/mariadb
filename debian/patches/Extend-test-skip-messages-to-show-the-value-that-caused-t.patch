+  skip Needs SSL (current have_ssl=$have_ssl);
 }
diff --git a/mysql-test/include/have_tlsv13.inc b/mysql-test/include/have_tlsv13.inc
index ef897d9..d0924ffb 100644
--- a/mysql-test/include/have_tlsv13.inc
+++ b/mysql-test/include/have_tlsv13.inc
@@ -1,8 +1,9 @@
 --disable_query_log
 connect (ssl_connection,localhost,root,,,,,SSL);
 
+--let $ssl_version= `SELECT VARIABLE_VALUE FROM information_schema.SESSION_STATUS WHERE VARIABLE_NAME = 'ssl_version'`
 if (`SELECT VARIABLE_VALUE NOT LIKE 'TLSv1.3' FROM information_schema.SESSION_STATUS WHERE VARIABLE_NAME = 'ssl_version'`) {
-  skip Needs TLSv1.3;
+  skip Needs TLSv1.3 (current ssl_version=$ssl_version);
 }
 
 disconnect ssl_connection;
diff --git a/mysql-test/include/have_udf.inc b/mysql-test/include/have_udf.inc
index be7390f..2d05f1e 100644
--- a/mysql-test/include/have_udf.inc
+++ b/mysql-test/include/have_udf.inc
@@ -1,14 +1,15 @@
 #
 # Check if server has support for loading plugins
 #
+--let $have_dynamic_loading= `SELECT @@have_dynamic_loading`
 if (`SELECT @@have_dynamic_loading != 'YES'`) {
-  --skip UDF requires dynamic loading
+  --skip UDF requires dynamic loading (current have_dynamic_loading=$have_dynamic_loading);
 }
 
 #
 # Check if the variable UDF_EXAMPLE_LIB is set
 #
 if (!$UDF_EXAMPLE_SO) {
-  --skip Need udf example
+  --skip Need udf example (current UDF_EXAMPLE_SO=$UDF_EXAMPLE_SO);
 }
 
diff --git a/mysql-test/include/linux.inc b/mysql-test/include/linux.inc
index cc126ff..e8b8454 100644
--- a/mysql-test/include/linux.inc
+++ b/mysql-test/include/linux.inc
@@ -1,5 +1,6 @@
+--let $version_compile_os= `select @@version_compile_os`
 if (`select @@version_compile_os not LIKE 'Linux%'`)
 {
-  skip Need Linux;
+  skip Need Linux (current version_compile_os=$version_compile_os);
 }
 
diff --git a/mysql-test/include/require_openssl_client.inc b/mysql-test/include/require_openssl_client.inc
index 463c44f..e8c419e 100644
--- a/mysql-test/include/require_openssl_client.inc
