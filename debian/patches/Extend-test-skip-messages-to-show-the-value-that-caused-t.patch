From: =?utf-8?b?T3R0byBLZWvDpGzDpGluZW4=?= <otto@debian.org>
Date: Fri, 13 Mar 2026 13:38:01 +0000
Subject: Extend test skip messages to show the value that caused the skip

- have_openssl.inc: Show current have_openssl value
- have_ssl_communication.inc: Show current have_ssl value
- have_tlsv13.inc: Show current SSL version in use
- require_openssl_client.inc: Show $CLIENT_TLS_LIBRARY
- Show current @@binlog_format when skipping non-ROW format tests
- Show current @@have_dynamic_loading and UDF_EXAMPLE_SO for UDF tests
- Append the actual value of @@version_compile_os to the Linux skip messages
- Store the current binlog format in a variable and append it to the
  skip message, making it immediately visible why the test was skipped
---
 mysql-test/include/have_binlog_format_mixed_or_row.inc       | 3 ++-
 mysql-test/include/have_binlog_format_mixed_or_statement.inc | 4 ++--
 mysql-test/include/have_binlog_format_row.inc                | 3 ++-
 mysql-test/include/have_binlog_format_row_or_statement.inc   | 4 ++--
 mysql-test/include/have_openssl.inc                          | 3 ++-
 mysql-test/include/have_ssl_communication.inc                | 3 ++-
 mysql-test/include/have_tlsv13.inc                           | 3 ++-
 mysql-test/include/have_udf.inc                              | 5 +++--
 mysql-test/include/linux.inc                                 | 3 ++-
 mysql-test/include/require_openssl_client.inc                | 2 +-
 10 files changed, 20 insertions(+), 13 deletions(-)

diff --git a/mysql-test/include/have_binlog_format_mixed_or_row.inc b/mysql-test/include/have_binlog_format_mixed_or_row.inc
index c6c5284..06ab86d 100644
--- a/mysql-test/include/have_binlog_format_mixed_or_row.inc
+++ b/mysql-test/include/have_binlog_format_mixed_or_row.inc
@@ -1,6 +1,7 @@
 --source include/have_log_bin.inc
 
+--let $binlog_format= `SELECT @@binlog_format`
 if (`SELECT @@binlog_format = 'STATEMENT'`)
 {
-  --skip Neither MIXED nor ROW binlog format
+  --skip Neither MIXED nor ROW binlog format (current binlog_format=$binlog_format);
 }
diff --git a/mysql-test/include/have_binlog_format_mixed_or_statement.inc b/mysql-test/include/have_binlog_format_mixed_or_statement.inc
index 3888dd4..c7352ea 100644
