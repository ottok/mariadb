 if (`SELECT @@binlog_format = 'MIXED'`)
 {
-  --skip Neither ROW nor STATEMENT binlog format
+  --skip Neither ROW nor STATEMENT binlog format (current binlog_format=$binlog_format);
 }
 
diff --git a/mysql-test/include/have_openssl.inc b/mysql-test/include/have_openssl.inc
index ee51ee4..1a0b854 100644
--- a/mysql-test/include/have_openssl.inc
+++ b/mysql-test/include/have_openssl.inc
@@ -1,4 +1,5 @@
+--let $have_openssl= `SELECT VARIABLE_VALUE FROM information_schema.GLOBAL_VARIABLES WHERE VARIABLE_NAME = 'have_openssl'`
 if (`SELECT count(*) = 0 FROM information_schema.GLOBAL_VARIABLES WHERE
       VARIABLE_NAME = 'have_openssl' AND VARIABLE_VALUE = 'YES'`){
-  skip Needs OpenSSL;
+  skip Needs OpenSSL (current have_openssl=$have_openssl);
 }
diff --git a/mysql-test/include/have_ssl_communication.inc b/mysql-test/include/have_ssl_communication.inc
index 84278e7..b976aa1 100644
--- a/mysql-test/include/have_ssl_communication.inc
+++ b/mysql-test/include/have_ssl_communication.inc
@@ -1,4 +1,5 @@
+--let $have_ssl= `SELECT VARIABLE_VALUE FROM information_schema.GLOBAL_VARIABLES WHERE VARIABLE_NAME = 'have_ssl'`
 if (`SELECT count(*) = 0 FROM information_schema.GLOBAL_VARIABLES WHERE
       VARIABLE_NAME = 'have_ssl' AND VARIABLE_VALUE = 'YES'`){
